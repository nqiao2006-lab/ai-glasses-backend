# This file is documentation only. Set these in Render Environment or your shell.
# Do not load the parent project's .env (its VISION_BASE_URL means cloud-model URL).
VISION_API_TOKEN=
VISION_DATA_DIR=/var/data/medicine-vision
VISION_INFERENCE_TIMEOUT=120
VISION_STARTUP_TIMEOUT=180
VISION_WAITING_TIMEOUT=600
VISION_CORS_ALLOW_ORIGINS=
PYTHONUNBUFFERED=1
# PORT is injected by Render; local default is 8001 to avoid the old service on 8000.
# VISION_BASE_URL is used ONLY by verify_render.py: the new OCR HTTPS root URL.
