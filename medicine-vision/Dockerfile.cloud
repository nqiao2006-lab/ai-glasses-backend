# Tencent Cloud OCR engine. Entry point is deploy_vision.py, exactly like the
# original Dockerfile, so the Render Start Command does not change.
#
# Differences from the original Dockerfile:
#   * no restore_models.py    - the 133 MB Paddle weights are never needed
#   * no verify_bundle.py     - it asserts those Paddle weights
#   * no paddle import check  - paddle is not installed
#   * no libgomp1             - that was Paddle's OpenMP runtime
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY requirements-cloud.txt ./
RUN python -m pip install -r requirements-cloud.txt && python -m pip check
COPY . .
RUN rm -rf models
RUN python -c "import cv2, numpy, PIL, fastapi, uvicorn, psutil; import tencentcloud.ocr.v20181119; import deployment; import ocr_cloud_tencent"
CMD ["python", "deploy_vision.py"]
